{
  "name": "premiumin-plus",
  "version": "3.2.2",
  "description": "Premiumin Plus V3.2 monorepo",
  "main": "apps/api/backend/server.js",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "apps/web",
    "apps/api/backend",
    "apps/bot-engine"
  ],
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/api/backend run backend",
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "dev:backend": "npm --prefix apps/api/backend run dev",
    "start:backend": "npm --prefix apps/api/backend run backend",
    "dev:bot": "npm --prefix apps/bot-engine run dev",
    "start:bot": "npm --prefix apps/bot-engine run bot"
  },
  "keywords": [
    "premiumin-plus",
    "monorepo"
  ],
  "author": "Your Name",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

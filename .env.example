# Premku / backend integration
NODE_ENV="development"
PORT="4000"
API_KEY="YOUR_PREMKU_API_KEY"
BASE_URL="https://premku.com/api/"
ADMIN_WHATSAPP="6285888009931"
ADMIN="YOUR_ADMIN_CONTACT"

# MySQL
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="apps_premhytam"

# Frontend API bridge
VITE_API_BASE_URL="http://localhost:4000/api"
FRONTEND_ORIGIN="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# WhatsApp bot engine
WEB_CORE_URL="http://localhost:4000"
BOT_ENGINE_PORT="4010"
VITE_BOT_ENGINE_URL="http://localhost:4010"
BOT_ENGINE_CORS_ORIGIN="http://localhost:3000"
BOT_SESSIONS_DIR=""
BOT_SESSION_CLEANUP_ENABLED="true"
BOT_SESSION_FILE_TTL_HOURS="24"
BOT_SESSION_CLEANUP_INTERVAL_MINUTES="60"

# Optional webhook hardening
PREMKU_WEBHOOK_SECRET=""
JWT_SECRET="change-this-long-random-session-secret"

# Optional WhatsApp delivery gateway.
# If empty, order delivery status becomes manual_pending instead of fake sent.
WHATSAPP_DELIVERY_WEBHOOK=""
WHATSAPP_DELIVERY_TOKEN=""

# Optional first-admin bootstrap for empty database
ADMIN_USERNAME="admin"
# Prefer a scrypt hash generated by backend/src/utils/password.js.
ADMIN_PASSWORD_HASH=""

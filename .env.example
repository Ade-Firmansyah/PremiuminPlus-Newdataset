# Premku / backend integration
NODE_ENV="development"
PORT="4000"
API_KEY="YOUR_PREMKU_API_KEY"
BASE_URL="https://premku.com/api/"
JWT_SECRET="change-this-long-random-session-secret"
API_BASE_URL="http://localhost:4000/api"
ADMIN_WHATSAPP="6285888009931"
ADMIN="YOUR_ADMIN_CONTACT"
PREMKU_PAY_STATUS_CACHE_MS="25000"
PREMKU_ORDER_STATUS_CACHE_MS="30000"
WEB_SESSION_TIMEOUT_MS="1800000"
REALTIME_EMIT_DEBOUNCE_MS="1200"
DASHBOARD_CACHE_MS="30000"
PRODUCTS_CACHE_MS="15000"
BOT_CATALOG_CACHE_MS="15000"
MEMORY_CACHE_MAX_ENTRIES="500"
CLEANUP_RETENTION_DAYS="7"
PROVIDER_SYNC_INTERVAL_MS="60000"
PROVIDER_PRODUCT_SYNC_INTERVAL_MS="60000"
VERBOSE_PREMKU_LOGS="false"
VERBOSE_SYSTEM_LOGS="false"

# MySQL
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="root"
DB_NAME="apps_premhytam"

# Frontend/API bridge
# Leave VITE_* empty for auto host detection in local LAN/mobile testing.
# Set explicit HTTPS URLs when deploying frontend/backend on separate domains.
# Production hybrid example:
# - Vercel frontend: VITE_API_BASE_URL="https://api.premiuminplus.store"
# - Railway backend: FRONTEND_ORIGIN="https://premiuminplus.store" and CORS_ORIGIN="https://premiuminplus.store"
# - Keep VITE_BOT_ENGINE_URL empty unless bot.domain.com is intentionally public.
VITE_API_BASE_URL=""
FRONTEND_ORIGIN="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# WhatsApp bot engine
WEB_CORE_URL="http://localhost:4000"
BOT_ENGINE_URL="http://localhost:4010"
BOT_ENGINE_PORT="4010"
VITE_BOT_ENGINE_URL=""
BOT_ENGINE_CORS_ORIGIN="http://localhost:3000"
# Production Railway example:
# WEB_CORE_URL="https://api.premiuminplus.store"
# API_BASE_URL="https://api.premiuminplus.store"
# BOT_ENGINE_URL="https://bot.premiuminplus.store"
# BOT_SESSIONS_DIR="/data/bot-sessions"
BOT_SESSIONS_DIR=""
BOT_SESSION_CLEANUP_ENABLED="true"
BOT_SESSION_FILE_TTL_HOURS="24"
BOT_SESSION_CLEANUP_INTERVAL_MINUTES="60"
BOT_PAYMENT_FIRST_CHECK_MS="5000"
BOT_PAYMENT_POLL_MS="20000"
BOT_PAYMENT_TIMEOUT_MS="1800000"

# Local dev helper only. npm run all will stop previous Node/npm/vite processes on app ports.
PREMIUMIN_AUTO_KILL_PORTS="true"

# MongoDB Atlas
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=PremiuminPlus"
MONGODB_DBNAME="premiuminpluus"
MONGO_SINGLE_SOURCE_OF_TRUTH="false"
ALLOW_LEGACY_SQL_IN_PRODUCTION="true"
MONGODB_MAX_POOL_SIZE="5"
MONGODB_MIN_POOL_SIZE="0"
MONGODB_SERVER_SELECTION_TIMEOUT_MS="10000"
MONGODB_SOCKET_TIMEOUT_MS="45000"
BACKUP_DIR="./backups"

# Optional webhook hardening
PREMKU_WEBHOOK_SECRET=""

# Optional WhatsApp delivery gateway.
# If empty, order delivery status becomes manual_pending instead of fake sent.
WHATSAPP_DELIVERY_WEBHOOK=""
WHATSAPP_DELIVERY_TOKEN=""

# Optional first-admin bootstrap for empty database
ADMIN_USERNAME="admin"
# Prefer a scrypt hash generated by backend/src/utils/password.js.
ADMIN_PASSWORD_HASH=""

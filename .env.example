NODE_ENV="production"
NODE_VERSION="20"
PORT="4000"

# Premku / backend integration
API_KEY="CHANGE_ME_PREMKU_API_KEY"
BASE_URL="https://premku.com/api/"
ADMIN_WHATSAPP="6285888009931"
ADMIN="6285888009931"

# Railway MySQL (Production)
# DATABASE_URL is optional. Individual Railway MySQL variables are supported too.
DATABASE_URL=""
DB_HOST="${{MySQL.MYSQLHOST}}"
DB_PORT="${{MySQL.MYSQLPORT}}"
DB_USER="${{MySQL.MYSQLUSER}}"
DB_PASSWORD="${{MySQL.MYSQLPASSWORD}}"
DB_NAME="${{MySQL.MYSQLDATABASE}}"
MYSQLHOST="${{MySQL.MYSQLHOST}}"
MYSQLPORT="${{MySQL.MYSQLPORT}}"
MYSQLUSER="${{MySQL.MYSQLUSER}}"
MYSQLPASSWORD="${{MySQL.MYSQLPASSWORD}}"
MYSQLDATABASE="${{MySQL.MYSQLDATABASE}}"

# Local development MySQL
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="root"
# DB_PASSWORD="root"
# DB_NAME="apps_premhytam"

# Vercel frontend
VITE_API_BASE_URL="/api"
FRONTEND_ORIGIN="https://premiuminplus.store"

# Optional webhook hardening
PREMKU_WEBHOOK_SECRET=""

# Optional WhatsApp delivery gateway.
# If empty, order delivery status becomes manual_pending instead of fake sent.
WHATSAPP_DELIVERY_WEBHOOK=""
WHATSAPP_DELIVERY_TOKEN=""

# Railway bot engine
BOT_ENGINE_URL="https://bot.premiuminplus.store"
BOT_ENGINE_TOKEN="CHANGE_ME_RANDOM_SHARED_TOKEN"
BOT_ENGINE_PORT="4100"
BOT_API_BASE_URL="https://premiuminplus.store/api"
BOT_RESELLER_API_KEY=""
BOT_SESSION_ID="default"
ADMIN_MONITORING_LID="64957102211197@lid"

# Maintenance and QR timers
DATA_RETENTION_DAYS="7"
MAINTENANCE_INTERVAL_MINUTES="1440"
PAYMENT_QR_TTL_MINUTES="30"

# Optional first-admin bootstrap for empty database
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Prefer a scrypt hash generated by apps/api/backend/src/utils/password.js.
ADMIN_PASSWORD_HASH=""

# VPS backend + bot-engine production env.
# Copy to .env on the VPS and fill secrets there.

NODE_ENV=production
PORT=4000

# Premku/provider secrets. Never expose these in Vercel/frontend.
API_KEY=YOUR_PREMKU_API_KEY
BASE_URL=https://premku.com/api/
PREMKU_WEBHOOK_SECRET=
JWT_SECRET=CHANGE_THIS_LONG_RANDOM_SECRET

# MySQL on VPS.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=premiumin
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_NAME=apps_premhytam

# Public domains.
FRONTEND_ORIGIN=https://domainkamu.com
CORS_ORIGIN=https://domainkamu.com
WEB_CORE_URL=https://api.domainkamu.com

# Backend talks to bot-engine locally for lower latency and better security.
# Use https://bot.domainkamu.com only if backend must reach bot-engine through public Nginx.
BOT_ENGINE_URL=http://127.0.0.1:4010
BOT_ENGINE_PORT=4010
BOT_ENGINE_CORS_ORIGIN=https://domainkamu.com
BOT_SESSIONS_DIR=./bot-engine/sessions
BOT_SESSION_CLEANUP_ENABLED=true

# Payment and polling guards.
PREMKU_PAY_STATUS_CACHE_MS=25000
PREMKU_ORDER_STATUS_CACHE_MS=30000
BOT_PAYMENT_FIRST_CHECK_MS=5000
BOT_PAYMENT_POLL_MS=20000
BOT_PAYMENT_TIMEOUT_MS=1800000

# Lightweight cache/realtime defaults.
REALTIME_EMIT_DEBOUNCE_MS=1200
DASHBOARD_CACHE_MS=30000
PRODUCTS_CACHE_MS=20000
BOT_CATALOG_CACHE_MS=20000
PROVIDER_SYNC_INTERVAL_MS=60000
PROVIDER_PRODUCT_SYNC_INTERVAL_MS=60000
VERBOSE_SYSTEM_LOGS=false
VERBOSE_PREMKU_LOGS=false

# Admin/bootstrap and optional delivery gateway.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_WHATSAPP=
WHATSAPP_DELIVERY_WEBHOOK=
WHATSAPP_DELIVERY_TOKEN=

# Vercel frontend only.
# Set these in Vercel Project Settings -> Environment Variables.

VITE_API_BASE_URL=https://api.domainkamu.com/api

# Recommended: keep empty because bot QR/status is proxied through backend polling.
# If you expose bot-engine publicly through Nginx + SSL, use:
# VITE_BOT_ENGINE_URL=https://bot.domainkamu.com
VITE_BOT_ENGINE_URL=

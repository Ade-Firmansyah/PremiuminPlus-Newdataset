# Vercel frontend only.
# Set these in Vercel Project Settings -> Environment Variables.

VITE_API_BASE_URL=https://api.premiuminplus.store

# Recommended: keep empty because bot QR/status is proxied through backend polling.
# If you expose bot-engine publicly through Railway custom domain, use:
# VITE_BOT_ENGINE_URL=https://bot.premiuminplus.store
VITE_BOT_ENGINE_URL=
